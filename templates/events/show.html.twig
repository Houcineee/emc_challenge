{% extends 'base.html.twig' %}

{% block title %}{{ event.title }} — Plan de Salle 3D | Théâtre Royal{% endblock %}

{% block stylesheets %}
<style>
    #theater-canvas-container {
        position: relative;
        width: 100%;
        height: 680px;
        background: radial-gradient(circle at center, #111520 0%, #07090e 100%);
        border-radius: 1.5rem;
        overflow: hidden;
    }
    #theater-canvas {
        width: 100%;
        height: 100%;
        display: block;
    }
    #seat-tooltip {
        pointer-events: none;
        transition: opacity 0.15s ease-out;
        z-index: 30;
    }
</style>
{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- Top Navigation & Spectacle Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 glass-panel border border-slate-800 rounded-2xl p-4 sm:p-6">
        <div class="flex items-center gap-4">
            <a href="/" class="px-3.5 py-2 rounded-xl bg-theater-900 hover:bg-theater-800 text-slate-300 hover:text-white border border-slate-700 text-xs font-semibold transition flex items-center gap-1.5">
                <span>←</span> <span>Retour aux spectacles</span>
            </a>
            <div>
                <div class="flex items-center gap-2">
                    <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">
                        {{ event.eventType ? event.eventType.name : 'SPECTACLE' }}
                    </span>
                    <span class="text-slate-600">•</span>
                    <span class="text-xs text-slate-400">
                        {{ event.startsAt ? event.startsAt|date('d F Y à H:i') : '' }}
                    </span>
                    {% if isFrontStageStanding %}
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-purple-950/80 text-purple-300 border border-purple-800/60">
                        Fosse Debout
                    </span>
                    {% else %}
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-950/80 text-amber-300 border border-amber-800/60">
                        100% Places Assises
                    </span>
                    {% endif %}
                </div>
                <h1 class="font-serif text-2xl sm:text-3xl font-bold text-white mt-0.5">
                    {{ event.title }}
                </h1>
            </div>
        </div>

        <div class="text-right hidden sm:block">
            <div class="text-xs text-slate-400 uppercase tracking-wider">Tarif de base</div>
            <div class="text-xl font-bold text-gold-400">{{ startingPriceMad }} MAD</div>
        </div>
    </div>

    <!-- Main Workspace: 3D Theater + Side Cart Panel -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- 3D Canvas Viewport (8 cols) -->
        <div class="lg:col-span-8 space-y-4">
            <div id="theater-canvas-container" class="border border-slate-800 shadow-2xl relative">
                
                <!-- WebGL Canvas -->
                <canvas id="theater-canvas" data-event-id="{{ event.id }}" data-is-standing="{{ isFrontStageStanding ? 'true' : 'false' }}"></canvas>

                <!-- Floating Camera Preset Buttons (Top Left) -->
                <div class="absolute top-4 left-4 z-20 flex flex-wrap gap-2">
                    <button type="button" onclick="setCameraPreset('scene')" class="px-3 py-1.5 rounded-lg glass-panel hover:glass-panel-gold border border-slate-700 hover:border-gold-500/40 text-xs font-semibold text-slate-200 hover:text-white transition flex items-center gap-1.5 shadow-md">
                        <span>👁️</span> <span>Vue Scène</span>
                    </button>
                    <button type="button" onclick="setCameraPreset('top')" class="px-3 py-1.5 rounded-lg glass-panel hover:glass-panel-gold border border-slate-700 hover:border-gold-500/40 text-xs font-semibold text-slate-200 hover:text-white transition flex items-center gap-1.5 shadow-md">
                        <span>📐</span> <span>Vue Dessus (2D)</span>
                    </button>
                    <button type="button" onclick="setCameraPreset('panoramic')" class="px-3 py-1.5 rounded-lg glass-panel hover:glass-panel-gold border border-slate-700 hover:border-gold-500/40 text-xs font-semibold text-slate-200 hover:text-white transition flex items-center gap-1.5 shadow-md">
                        <span>🎭</span> <span>Vue Panoramique 3D</span>
                    </button>
                </div>

                <!-- Floating Legend (Bottom Left) -->
                <div class="absolute bottom-4 left-4 z-20 glass-panel border border-slate-800 rounded-xl px-3.5 py-2.5 text-xs text-slate-300 flex flex-wrap items-center gap-4 shadow-xl">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-emerald-500 shadow-sm shadow-emerald-500/50"></span>
                        <span>Disponible</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-amber-500 shadow-sm shadow-amber-500/50 animate-pulse"></span>
                        <span>Mon Panier</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-rose-500"></span>
                        <span>Vendu</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-slate-600"></span>
                        <span>Réservé (15m)</span>
                    </div>
                </div>

                <!-- Floating Hover Tooltip -->
                <div id="seat-tooltip" class="absolute hidden glass-panel-gold border border-gold-500/40 rounded-xl px-4 py-2.5 text-xs shadow-2xl backdrop-blur-xl">
                    <div class="font-bold text-white text-sm" id="tooltip-seat-name">Siège A-01</div>
                    <div class="text-gold-400 font-semibold" id="tooltip-seat-zone">Orchestre (+50%)</div>
                    <div class="flex items-center justify-between gap-4 mt-1 text-[11px] text-slate-300">
                        <span id="tooltip-seat-price" class="font-mono text-white font-bold">225 MAD</span>
                        <span id="tooltip-seat-status" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Disponible</span>
                    </div>
                </div>

                <!-- Loader Overlay -->
                <div id="canvas-loader" class="absolute inset-0 z-30 bg-theater-950 flex flex-col items-center justify-center gap-3 transition-opacity duration-300">
                    <div class="w-10 h-10 border-4 border-gold-500/20 border-t-gold-500 rounded-full animate-spin"></div>
                    <div class="text-sm font-serif text-gold-400">Génération du Théâtre Royal en 3D...</div>
                </div>
            </div>

            <!-- Toast Notification Container -->
            <div id="toast-container" class="fixed bottom-6 right-6 z-50 space-y-2 pointer-events-none"></div>
        </div>

        <!-- Right Side Panel: Zones Tarifs & Cart Widget (4 cols) -->
        <div class="lg:col-span-4 space-y-6">

            <!-- "Mes Sélections" Cart Drawer -->
            <div class="glass-panel-gold border border-gold-500/30 rounded-2xl p-6 shadow-xl space-y-5">
                <div class="flex items-center justify-between border-b border-gold-500/20 pb-3">
                    <div class="flex items-center gap-2">
                        <span class="text-lg">🛒</span>
                        <h2 class="font-serif text-lg font-bold text-white">Mes Réservations</h2>
                    </div>
                    <span id="held-count-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-gold-500 text-theater-950">
                        0 place
                    </span>
                </div>

                <!-- Held Seats List -->
                <div id="held-seats-list" class="space-y-2.5 max-h-60 overflow-y-auto pr-1">
                    <div class="text-center py-6 text-xs text-slate-400">
                        Cliquez sur un siège vert pour le réserver pendant 15 minutes.
                    </div>
                </div>

                <!-- Subtotal and Checkout Button -->
                <div class="pt-3 border-t border-gold-500/20 space-y-4">
                    <div class="flex items-center justify-between">
                        <span class="text-xs uppercase tracking-wider text-slate-300">Total panier</span>
                        <span id="held-total-price" class="text-xl font-bold font-mono gold-gradient-text">0 MAD</span>
                    </div>

                    <a href="/checkout" id="checkout-cta-button" class="w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-gradient-to-r from-gold-500 to-gold-600 hover:from-gold-400 hover:to-gold-500 text-theater-950 font-bold text-sm uppercase tracking-wider shadow-lg shadow-gold-500/20 transition opacity-50 pointer-events-none">
                        <span>Passer à la caisse</span>
                        <span>→</span>
                    </a>

                    <div class="text-[11px] text-center text-slate-400 flex items-center justify-center gap-1.5">
                        <span>⏱️</span>
                        <span>Verrouillage garanti 15 minutes via Redis</span>
                    </div>
                </div>
            </div>

            <!-- Zones & Tarifs Breakdown -->
            <div class="glass-panel border border-slate-800 rounded-2xl p-6 space-y-4">
                <div class="flex items-center gap-2">
                    <span class="text-base">🏷️</span>
                    <h3 class="font-serif text-base font-bold text-white">Grille Tarifaire du Spectacle</h3>
                </div>

                <div class="space-y-2 text-xs">
                    {% for item in zonePricing %}
                    <div class="flex items-center justify-between p-2.5 rounded-xl bg-theater-900/60 border border-slate-800">
                        <div>
                            <div class="font-semibold text-slate-200">
                                {% if item.zone.name.value == 'FRONT_STAGE' %}
                                    Fosse Avant-Scène {{ item.isSeated ? '(Assis)' : '(Debout)' }}
                                {% elseif item.zone.name.value == 'ORCHESTRA' %}
                                    Orchestre Prestige
                                {% elseif item.zone.name.value == 'LEFT_BOX' %}
                                    Loge Privée Gauche
                                {% elseif item.zone.name.value == 'RIGHT_BOX' %}
                                    Loge Privée Droite
                                {% else %}
                                    Balcon & Galerie
                                {% endif %}
                            </div>
                            <div class="text-[10px] text-slate-400">
                                Multiplicateur: {{ item.zone.priceMultiplierPercent >= 0 ? '+' : '' }}{{ item.zone.priceMultiplierPercent }}%
                            </div>
                        </div>
                        <div class="font-mono font-bold text-gold-400 text-sm">
                            {{ item.priceMad }} MAD
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<!-- Three.js r128 CDN and OrbitControls CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script src="/js/theater-3d.js"></script>
{% endblock %}
