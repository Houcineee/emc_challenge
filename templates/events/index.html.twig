{% extends 'base.html.twig' %}

{% block title %}Saison 2026-2027 — Les Grands Spectacles | Théâtre Royal{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">

    <!-- Hero Banner -->
    <div class="relative rounded-3xl overflow-hidden glass-panel border border-slate-800 p-8 sm:p-12 lg:p-16 text-center">
        <div class="absolute inset-0 bg-gradient-to-r from-gold-500/10 via-transparent to-gold-500/5 pointer-events-none"></div>
        <div class="relative z-10 max-w-3xl mx-auto space-y-4">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold tracking-widest uppercase">
                <span>✦</span> Billetterie Officielle & Expérience 3D Interactive <span>✦</span>
            </div>
            <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-tight">
                Saison 2026-2027<br>
                <span class="gold-gradient-text">Les Grands Spectacles</span>
            </h1>
            <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto">
                Théâtre Royal de la Ville • 400 Places d'Exception.<br class="hidden sm:inline">
                Explorez la salle en 3D immersive et choisissez votre siège en temps réel.
            </p>
        </div>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex flex-wrap items-center justify-center gap-3">
        <button type="button" onclick="filterCategory('ALL')" class="category-pill active px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition border border-gold-500 bg-gold-500 text-theater-950 shadow-lg shadow-gold-500/20" data-cat="ALL">
            Tous les spectacles
        </button>
        <button type="button" onclick="filterCategory('CONCERT')" class="category-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition border border-slate-700 bg-theater-900/80 text-slate-300 hover:border-gold-500/50 hover:text-white" data-cat="CONCERT">
            🎵 Concerts (Fosse Debout)
        </button>
        <button type="button" onclick="filterCategory('THEATRE')" class="category-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition border border-slate-700 bg-theater-900/80 text-slate-300 hover:border-gold-500/50 hover:text-white" data-cat="THEATRE">
            🎭 Pièces de Théâtre
        </button>
        <button type="button" onclick="filterCategory('CONFERENCE')" class="category-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition border border-slate-700 bg-theater-900/80 text-slate-300 hover:border-gold-500/50 hover:text-white" data-cat="CONFERENCE">
            🎙️ Conférences & Débats
        </button>
    </div>

    <!-- Event Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="events-grid">
        {% for item in eventsWithStats %}
            {% set event = item.entity %}
            {% set typeName = event.eventType ? event.eventType.name : 'AUTRE' %}
            <div class="event-card group relative rounded-2xl glass-panel hover:glass-panel-gold border border-slate-800 hover:border-gold-500/50 transition-all duration-300 flex flex-col justify-between overflow-hidden p-6 hover:-translate-y-1 hover:shadow-2xl hover:shadow-gold-500/10" data-category="{{ typeName }}">
                
                <!-- Category Badge & Date -->
                <div class="space-y-4">
                    <div class="flex items-center justify-between gap-2">
                        {% if typeName == 'CONCERT' %}
                            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold tracking-wider uppercase bg-purple-950/80 text-purple-300 border border-purple-800/60 flex items-center gap-1.5">
                                <span>🎵</span> Concert
                            </span>
                        {% elseif typeName == 'THEATRE' %}
                            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold tracking-wider uppercase bg-amber-950/80 text-amber-300 border border-amber-800/60 flex items-center gap-1.5">
                                <span>🎭</span> Théâtre
                            </span>
                        {% else %}
                            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold tracking-wider uppercase bg-sky-950/80 text-sky-300 border border-sky-800/60 flex items-center gap-1.5">
                                <span>🎙️</span> Conférence
                            </span>
                        {% endif %}

                        <span class="text-xs font-mono text-slate-400">
                            {{ event.startsAt ? event.startsAt|date('d/m/Y') : '' }}
                        </span>
                    </div>

                    <!-- Title & Description -->
                    <div>
                        <h2 class="font-serif text-2xl font-bold text-white group-hover:text-gold-400 transition-colors line-clamp-1">
                            {{ event.title }}
                        </h2>
                        <div class="text-xs text-gold-400/90 mt-1 flex items-center gap-1.5 font-medium">
                            <span>🕒</span>
                            <span>{{ event.startsAt ? event.startsAt|date('d F Y à H:i') : '' }}</span>
                        </div>
                        <p class="text-slate-400 text-sm mt-3 line-clamp-3 leading-relaxed">
                            {{ event.description }}
                        </p>
                    </div>
                </div>

                <!-- Footer Stats & CTA -->
                <div class="mt-6 pt-5 border-t border-slate-800/80 space-y-4">
                    <!-- Occupancy Bar -->
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between text-xs text-slate-400">
                            <span>Taux de remplissage</span>
                            <span class="font-semibold text-slate-200">{{ item.soldCount }}/400 places ({{ item.occupancyPercent }}%)</span>
                        </div>
                        <div class="w-full h-2 rounded-full bg-theater-800 overflow-hidden">
                            <div class="h-full rounded-full bg-gradient-to-r from-emerald-500 via-amber-500 to-rose-500 transition-all duration-500" style="width: {{ item.occupancyPercent }}%;"></div>
                        </div>
                    </div>

                    <!-- Price & CTA Button -->
                    <div class="flex items-center justify-between pt-1">
                        <div>
                            <div class="text-[10px] uppercase tracking-wider text-slate-400">Tarif</div>
                            <div class="font-semibold text-gold-400 text-base">
                                Dès {{ item.startingPriceMad }} MAD
                            </div>
                        </div>

                        <a href="/events/{{ event.id }}" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-gold-500 to-gold-600 hover:from-gold-400 hover:to-gold-500 text-theater-950 font-bold text-xs uppercase tracking-wider shadow-lg shadow-gold-500/20 group-hover:shadow-gold-500/40 transition">
                            <span>Plan 3D</span>
                            <span>→</span>
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-span-3 text-center py-16 glass-panel rounded-2xl border border-slate-800">
                <span class="text-4xl">🎭</span>
                <p class="text-slate-400 mt-2">Aucun spectacle programmé pour le moment.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    function filterCategory(category) {
        const pills = document.querySelectorAll('.category-pill');
        pills.forEach(p => {
            if (p.getAttribute('data-cat') === category) {
                p.classList.remove('bg-theater-900/80', 'text-slate-300', 'border-slate-700');
                p.classList.add('bg-gold-500', 'text-theater-950', 'border-gold-500', 'shadow-lg', 'shadow-gold-500/20');
            } else {
                p.classList.remove('bg-gold-500', 'text-theater-950', 'border-gold-500', 'shadow-lg', 'shadow-gold-500/20');
                p.classList.add('bg-theater-900/80', 'text-slate-300', 'border-slate-700');
            }
        });

        const cards = document.querySelectorAll('.event-card');
        cards.forEach(card => {
            if (category === 'ALL' || card.getAttribute('data-category') === category) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>
{% endblock %}
