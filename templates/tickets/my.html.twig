{% extends 'base.html.twig' %}

{% block title %}Mes Billets — Théâtre Royal{% endblock %}

{% block stylesheets %}
<style>
    @media print {
        body { background: #fff !important; color: #000 !important; }
        header, footer, .no-print { display: none !important; }
        .ticket-card {
            border: 1px solid #000 !important;
            background: #fff !important;
            color: #000 !important;
            box-shadow: none !important;
            page-break-inside: avoid;
            margin-bottom: 24px !important;
        }
        .ticket-title { color: #000 !important; }
    }
    .ticket-card {
        background: var(--ink-2);
        border: 1px solid var(--rule);
        border-radius: 4px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        overflow: hidden;
    }
    .ticket-main {
        padding: 32px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 24px;
    }
    .ticket-stub {
        padding: 32px;
        border-left: 1px dashed var(--rule);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-width: 180px;
        background: rgba(0,0,0,0.25);
    }
    @media (max-width: 640px) {
        .ticket-card { grid-template-columns: 1fr; }
        .ticket-stub { border-left: 0; border-top: 1px dashed var(--rule); }
    }
</style>
{% endblock %}

{% block body %}
<div class="wrap" style="padding-top:48px;padding-bottom:96px;max-width:860px;">

    <!-- Header -->
    <div style="border-bottom:1px solid var(--rule);padding-bottom:28px;display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:16px;">
        <div>
            <p class="meta" style="margin-bottom:8px;">Espace Personnel</p>
            <h1 class="display" style="font-size:var(--t-1);">Mes Billets Officiels</h1>
        </div>

        {% if tickets is not empty %}
        <button type="button" onclick="window.print()" class="btn btn-ghost no-print" style="height:40px;padding-inline:18px;">
            Imprimer les billets
        </button>
        {% endif %}
    </div>

    <!-- Success notice -->
    <div id="success-alert" class="hidden no-print" style="margin-top:24px;padding:16px 20px;border:1px solid rgba(16,185,129,0.4);background:rgba(16,185,129,0.1);border-radius:4px;display:flex;justify-content:space-between;align-items:center;">
        <div>
            <strong style="color:var(--cream);">Paiement validé avec succès.</strong>
            <span class="meta" style="margin-left:8px;">Vos billets d'entrée sont émis ci-dessous.</span>
        </div>
        <button type="button" onclick="document.getElementById('success-alert').remove()" class="meta" style="cursor:pointer;">✕</button>
    </div>

    <!-- Tickets List -->
    <div style="margin-top:40px;display:grid;gap:24px;">
        {% if not isAuthenticated %}
            <div style="text-align:center;padding:64px 20px;border:1px solid var(--rule);border-radius:4px;">
                <h2 class="display" style="font-size:var(--t-3);margin-bottom:8px;">Connexion requise</h2>
                <p class="meta" style="margin-bottom:24px;">Veuillez vous connecter pour afficher vos billets.</p>
                <a href="/login" class="btn btn-solid">Se connecter</a>
            </div>
        {% elseif tickets is empty %}
            <div style="text-align:center;padding:64px 20px;border:1px solid var(--rule);border-radius:4px;">
                <h2 class="display" style="font-size:var(--t-3);margin-bottom:8px;">Aucun billet actif</h2>
                <p class="meta" style="margin-bottom:24px;">Vous n'avez pas encore acheté de places pour la saison 2026-2027.</p>
                <a href="/#programme" class="btn btn-solid">Découvrir le programme</a>
            </div>
        {% else %}
            {% for ticket in tickets %}
            {% set event = ticket.event %}
            {% set seat = ticket.seat %}
            {% set zone = seat.zone %}
            {% set canonicalCode = 'EMC-' ~ event.id ~ '-' ~ ticket.id %}

            <article class="ticket-card">
                <div class="ticket-main">
                    <div style="display:flex;justify-content:space-between;align-items:baseline;">
                        <span class="meta" style="text-transform:uppercase;letter-spacing:0.05em;">Théâtre Royal · Billet d'entrée officiel</span>
                        <span class="meta" style="color:var(--crimson);font-weight:500;">Place Confirmée</span>
                    </div>

                    <div>
                        <h2 class="display ticket-title" style="font-size:1.6rem;line-height:1.2;">
                            {{ event.title }}
                        </h2>
                        <p class="meta" style="margin-top:6px;font-family:monospace;">
                            {{ event.startsAt ? event.startsAt|date('l d F Y à H:i') : '' }}
                        </p>
                    </div>

                    <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:16px;border-top:1px solid var(--rule);padding-top:16px;">
                        <div>
                            <span class="meta" style="display:block;font-size:0.7rem;">Zone</span>
                            <span style="font-weight:500;font-size:var(--t-5);">{{ zone ? zone.name.value : 'Standard' }}</span>
                        </div>
                        <div>
                            <span class="meta" style="display:block;font-size:0.7rem;">Rang & Siège</span>
                            <span style="font-weight:500;font-size:var(--t-5);">Rang {{ seat.rowLabel }} — N° {{ seat.seatNumber }}</span>
                        </div>
                        <div>
                            <span class="meta" style="display:block;font-size:0.7rem;">Tarif</span>
                            <span style="font-weight:500;font-size:var(--t-5);">{{ (ticket.finalPriceCents / 100)|number_format(0) }} MAD</span>
                        </div>
                    </div>

                    <div style="display:flex;justify-content:space-between;font-size:0.75rem;color:var(--muted);border-top:1px solid var(--rule);padding-top:12px;">
                        <span>Titulaire : {{ ticket.user.email }}</span>
                        <span style="font-family:monospace;">#{{ canonicalCode }}</span>
                    </div>
                </div>

                <div class="ticket-stub">
                    <div id="qrcode-{{ ticket.id }}" style="background:#fff;padding:8px;border-radius:4px;" data-payload="{{ canonicalCode }}"></div>
                    <span style="font-family:monospace;font-size:0.75rem;color:var(--muted);letter-spacing:0.05em;">
                        {{ canonicalCode }}
                    </span>
                </div>
            </article>
            {% endfor %}
        {% endif %}
    </div>

</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('success') === '1') {
            const alert = document.getElementById('success-alert');
            if (alert) alert.classList.remove('hidden');
        }

        document.querySelectorAll('[id^="qrcode-"]').forEach(el => {
            const payload = el.getAttribute('data-payload');
            if (payload && typeof QRCode !== 'undefined') {
                el.innerHTML = '';
                new QRCode(el, {
                    text: payload,
                    width: 96,
                    height: 96,
                    colorDark: '#0C0A0B',
                    colorLight: '#ffffff',
                    correctLevel: QRCode.CorrectLevel.H
                });
            }
        });
    });
</script>
{% endblock %}
