<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Billet {{ canonicalCode }}</title>
    <style>
        @page { margin: 28px; }
        body { color: #0c0a0b; font-family: DejaVu Sans, sans-serif; margin: 0; }
        .header { border-bottom: 2px solid #b3121f; padding-bottom: 14px; }
        .brand { color: #b3121f; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; }
        h1 { font-size: 25px; margin: 24px 0 8px; }
        .date { color: #555; font-size: 13px; margin-bottom: 24px; }
        .details { border-top: 1px solid #ccc; border-bottom: 1px solid #ccc; padding: 18px 0; }
        .detail { display: inline-block; vertical-align: top; width: 31%; }
        .label { color: #777; font-size: 10px; text-transform: uppercase; }
        .value { font-size: 14px; margin-top: 5px; }
        .qr { margin-top: 28px; text-align: center; }
        .qr svg { width: 190px; height: 190px; }
        .code { font-family: monospace; font-size: 13px; letter-spacing: 1px; margin-top: 8px; }
        .footer { color: #777; font-size: 10px; margin-top: 24px; text-align: center; }
    </style>
</head>
<body>
    <div class="header">
        <div class="brand">Théâtre Royal · Billet d'entrée officiel</div>
    </div>

    <h1>{{ event.title }}</h1>
    <div class="date">{{ event.startsAt ? event.startsAt|date('l d F Y à H:i') : '' }}</div>

    <div class="details">
        <div class="detail">
            <div class="label">Zone</div>
            <div class="value">{{ seat.zone ? seat.zone.name.value : 'Standard' }}</div>
        </div>
        <div class="detail">
            <div class="label">Rang & siège</div>
            <div class="value">{{ seat.rowLabel }} · N° {{ seat.seatNumber }}</div>
        </div>
        <div class="detail">
            <div class="label">Tarif</div>
            <div class="value">{{ (ticket.finalPriceCents / 100)|number_format(0) }} MAD</div>
        </div>
    </div>

    <div class="qr">
        {{ qrSvg|raw }}
        <div class="code">{{ canonicalCode }}</div>
    </div>

    <div class="footer">
        Billet nominatif · Titulaire : {{ ticket.user.email }} · Présentez ce QR code à l'entrée.
    </div>
</body>
</html>
