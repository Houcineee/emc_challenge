<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Billet {{ canonicalCode }}</title>
    <style>
        @page { margin: 30px; }
        body { background: #f3efe7; color: #191416; font-family: DejaVu Sans, sans-serif; margin: 0; }
        .ticket { border: 1px solid #2b2023; border-radius: 12px; overflow: hidden; }
        .header { background: #24191c; color: #f8f2e8; padding: 22px 26px; }
        .brand { color: #dfaa72; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; }
        .type { color: #c9b9ae; float: right; font-size: 9px; letter-spacing: 1px; text-transform: uppercase; }
        .body { background: #fffaf2; padding: 26px; }
        h1 { color: #24191c; font-size: 27px; line-height: 1.15; margin: 0 0 9px; }
        .date { color: #8d2935; font-size: 13px; font-weight: bold; margin-bottom: 25px; }
        .details { border-bottom: 1px solid #d8cfc4; border-top: 1px solid #d8cfc4; padding: 18px 0; }
        .detail { display: inline-block; vertical-align: top; width: 31%; }
        .label { color: #8b7e78; font-size: 9px; letter-spacing: 1px; text-transform: uppercase; }
        .value { font-size: 13px; margin-top: 6px; }
        .stub { background: #f0e5d7; border-top: 1px dashed #8b7e78; padding: 22px 26px; text-align: center; }
        .qr { background: #fff; border: 7px solid #fff; display: inline-block; }
        .qr img { display: block; height: 180px; width: 180px; }
        .code { color: #24191c; font-family: monospace; font-size: 12px; letter-spacing: 1px; margin-top: 10px; }
        .footer { color: #776d68; font-size: 9px; line-height: 1.5; margin-top: 18px; text-align: center; }
    </style>
</head>
<body>
    <div class="ticket">
        <div class="header">
            <span class="brand">Théâtre Royal</span>
            <span class="type">Billet officiel · Accès unique</span>
        </div>
        <div class="body">
            <h1>{{ event.title }}</h1>
            <div class="date">{{ event.startsAt ? event.startsAt|date('l d F Y à H:i') : '' }}</div>

            <div class="details">
                <div class="detail">
                    <div class="label">Zone</div>
                    <div class="value">{{ seat.zone ? seat.zone.name.value : 'Standard' }}</div>
                </div>
                <div class="detail">
                    <div class="label">Rang & siège</div>
                    <div class="value">{{ seat.rowLabel }} · N° {{ seat.seatNumber }}</div>
                </div>
                <div class="detail">
                    <div class="label">Tarif</div>
                    <div class="value">{{ (ticket.finalPriceCents / 100)|number_format(0) }} MAD</div>
                </div>
            </div>
        </div>
        <div class="stub">
            <div class="qr"><img src="{{ qrDataUri }}" alt="QR code {{ canonicalCode }}"></div>
            <div class="code">{{ canonicalCode }}</div>
            <div class="footer">
                Billet nominatif · {{ ticket.user.email }}<br>
                Présentez ce QR code à l'entrée.
            </div>
        </div>
    </div>
</body>
</html>
