{% extends 'base.html.twig' %}

{% block title %}Connexion — Théâtre Royal{% endblock %}

{% block body %}
<div class="wrap" style="min-height:70vh;display:flex;align-items:center;justify-content:center;padding-block:64px;">
    <div style="width:100%;max-width:440px;">
        
        <!-- Header -->
        <div style="text-align:center;margin-bottom:36px;">
            <p class="meta" style="text-transform:uppercase;letter-spacing:0.1em;margin-bottom:8px;">Espace Réservé</p>
            <h1 class="display" style="font-size:var(--t-2);">Connexion</h1>
            <p class="meta" style="margin-top:6px;">Accédez à vos billets officiels et à votre compte</p>
        </div>

        <!-- Form Card -->
        <div style="background:var(--ink-2);border:1px solid var(--rule);border-radius:4px;padding:36px 32px;">
            
            {% if error %}
                <div style="margin-bottom:20px;padding:12px;background:rgba(179,18,31,0.2);border:1px solid var(--crimson);border-radius:4px;color:var(--cream);font-size:var(--t-5);text-align:center;">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form action="/api/auth/login" method="post" id="login-form" style="display:grid;gap:18px;">
                <div>
                    <label for="email" class="meta" style="display:block;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;">
                        Adresse email
                    </label>
                    <input type="email" id="email" name="email" value="{{ last_username }}" required autocomplete="email" placeholder="nom@exemple.com" style="width:100%;background:var(--ink);border:1px solid var(--rule);color:var(--cream);font-family:var(--sans);font-size:var(--t-5);padding:12px 16px;border-radius:4px;outline:none;">
                </div>

                <div>
                    <label for="password" class="meta" style="display:block;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;">
                        Mot de passe
                    </label>
                    <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••" style="width:100%;background:var(--ink);border:1px solid var(--rule);color:var(--cream);font-family:var(--sans);font-size:var(--t-5);padding:12px 16px;border-radius:4px;outline:none;">
                </div>

                <div style="margin-top:8px;">
                    <button type="submit" id="login-submit-btn" class="btn btn-solid" style="width:100%;height:46px;">
                        Se connecter
                    </button>
                </div>
            </form>

            <!-- Quick evaluation access -->
            <div style="margin-top:32px;padding-top:24px;border-top:1px solid var(--rule);">
                <p class="meta" style="text-align:center;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:14px;font-size:0.7rem;">
                    Comptes de démonstration (Accès direct)
                </p>
                <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:8px;">
                    <button type="button" onclick="quickLoginAndRedirect('ADMIN', '/admin')" class="btn btn-ghost" style="height:36px;font-size:0.75rem;padding-inline:8px;">
                        Direction
                    </button>
                    <button type="button" onclick="quickLoginAndRedirect('CASHIER', '/cashier')" class="btn btn-ghost" style="height:36px;font-size:0.75rem;padding-inline:8px;">
                        Guichet
                    </button>
                    <button type="button" onclick="quickLoginAndRedirect('CLIENT', '/')" class="btn btn-ghost" style="height:36px;font-size:0.75rem;padding-inline:8px;">
                        Spectateur
                    </button>
                </div>
            </div>

        </div>

        <p class="meta" style="text-align:center;margin-top:24px;">
            <a href="/" style="border-bottom:1px solid var(--rule);padding-bottom:2px;">← Retour à la programmation</a>
        </p>

    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    async function quickLoginAndRedirect(role, redirectUrl) {
        try {
            const res = await fetch('/api/auth/quick-login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ role: role })
            });
            if (res.ok) {
                window.location.href = redirectUrl;
            } else {
                const data = await res.json();
                showAppToast(data.error || 'Erreur lors de la connexion.');
            }
        } catch (e) {
            console.error(e);
        }
    }

    document.getElementById('login-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('email').value;
        const password = document.getElementById('password').value;
        const btn = document.getElementById('login-submit-btn');

        btn.disabled = true;
        btn.innerText = 'Connexion en cours...';

        try {
            const res = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email, password: password })
            });
            const data = await res.json();
            if (res.ok) {
                window.location.href = '/';
            } else {
                showAppToast(data.error || 'Identifiants invalides.');
                btn.disabled = false;
                btn.innerText = 'Se connecter';
            }
        } catch (err) {
            showAppToast('Erreur réseau. Vérifiez votre connexion puis réessayez.');
            btn.disabled = false;
            btn.innerText = 'Se connecter';
        }
    });
</script>
{% endblock %}
