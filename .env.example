# Copy to .env.local and fill in. Never commit real secrets.
APP_ENV=dev
APP_SECRET=change-me

MYSQL_DATABASE=ticketing
MYSQL_USER=app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

DATABASE_URL="mysql://app:change-me@mysql:3306/ticketing?serverVersion=8.0&charset=utf8mb4"
REDIS_URL="redis://redis:6379"

# Optional Google Sheets integration.
# GOOGLE_SERVICE_ACCOUNT_JSON=/app/var/secrets/google-service-account.json
# GOOGLE_SHEETS_ID=
